def stepEvent (s : dma_axi32_core0_chState) (i : dma_axi32_core0_chInputs) (event : ClockEvent) : dma_axi32_core0_chState :=
  let s_pre := comb s i
  let s_next := commitEvent s_pre i event
  let s_settled := comb s_next i
  s_settled

