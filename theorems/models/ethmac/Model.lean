/-- One hardware clock event: settle combinational logic, commit one domain, settle outputs -/
def stepEvent (s : ethmacState) (i : ethmacInputs) (event : ClockEvent) : ethmacState :=
  let s_pre := comb s i
  let s_next := commitEvent s_pre i event
  let s_settled := comb s_next i
  s_settled

/-- Uniform multi-clock entry point -/
def step (s : ethmacState) (i : ethmacInputs) (event : ClockEvent) : ethmacState := stepEvent s i event

/-- Output helper -/
def outputs (s : ethmacState) : ethmacOutputs :=
  {
    wb_dat_o := s.wb_dat_o
    wb_ack_o := s.wb_ack_o
    wb_err_o := s.wb_err_o
    m_wb_adr_o := s.m_wb_adr_o
